# Copiar a .env y ajustar. Sin .env, todo corre local: disco, cola en línea y memoria.

# Almacenamiento de archivos: local | s3
STORAGE_BACKEND=s3
S3_BUCKET=filtro-planos
# Vacío para AWS; con MinIO u otro compatible, su URL
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Cola de trabajos: inline | redis
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
QUEUE_STREAM=filtro-planos:trabajos
TRAINING_STREAM=filtro-planos:entrenamiento

# Metadatos: memory | postgres (apunta a PgBouncer, no directo a Postgres)
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://planos:cambiar@pgbouncer:6432/planos

# Ingesta
PDF_DPI=200
MAX_UPLOAD_MB=100
MAX_PIXELS=150000000

# Filtro
ENVELOPE_PARAMS=/app/config/envelope_params.json
DETECTOR=none
